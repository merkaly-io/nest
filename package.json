{
  "name": "@merkaly/nest",
  "version": "0.2.8",
  "description": "Shared NestJS runtime and tooling for Merkaly backend apps: pinned versions plus RabbitMQ events, logger, filters, config and signatures",
  "repository": {
    "type": "git",
    "url": "https://github.com/merkaly-io/nest.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "tsc -b --clean",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint .",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/microservices": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/swagger": "^11.4.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "nestjs-console": "^10.0.0",
    "prettier": "^3.9.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "changelogen": "^0.6.2"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.5.0": "^2.5.0",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "js-yaml@>=5.0.0 <5.4.1": "^5.4.1"
    }
  }
}
