{
  "name": "@merkaly/nest",
  "version": "0.2.0",
  "description": "Shared NestJS runtime for Merkaly backend apps: pinned Nest versions plus RabbitMQ events, logger, filters, health, config and signatures",
  "repository": {
    "type": "git",
    "url": "https://github.com/merkaly-io/nest.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "tsc -b --clean",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint .",
    "prepack": "pnpm build"
  },
  "prettier": "@merkaly/nest-tooling/prettier",
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/microservices": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "nestjs-console": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@merkaly/nest-tooling": "workspace:*",
    "changelogen": "^0.6.2"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  }
}
